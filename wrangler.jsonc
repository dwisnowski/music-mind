{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-mind",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/samples/private/*"]
  },
  "routes": [
    { "pattern": "musicmind.wildideazone.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "PRIVATE_SCORES",
      "id": "bcd4dfa2a34a4b4bbc0d09f1e9869db6"
    }
  ],
  "vars": {
    "OWNER_EMAILS": "dwisnows@gmail.com"
  },
  // Set via `wrangler secret put CF_ACCESS_TEAM_DOMAIN` and `wrangler secret put CF_ACCESS_AUD`
  // after creating the Zero Trust Access app (see docs/private-scores.md).
  // Local only: PRIVATE_SCORES_DEV_BYPASS=1 in .dev.vars to skip JWT when secrets are unset.
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
